{
  "name": "weather-app-hng-14-mobile-stage-3",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export -p web",
    "desktop:dev": "concurrently -k -n expo,electron -c blue,magenta \"BROWSER=none expo start --web\" \"wait-on http://localhost:8081 && ELECTRON_DEV=1 electron --no-sandbox electron/main.js\"",
    "desktop:build:linux": "expo export -p web && electron-builder --linux AppImage",
    "desktop:build:win": "expo export -p web && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hng14.weatherapp",
    "productName": "Weather",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@tanstack/react-query": "^5.100.6",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "^4.1.7",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.5"
  },
  "private": true
}
